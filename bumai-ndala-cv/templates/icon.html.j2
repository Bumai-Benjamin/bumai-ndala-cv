<!doctype html>
<html lang="en" data-theme="light">
<head><meta charset="utf-8"><link rel="stylesheet" href="/assets/css/site.css?v={{ v.css }}">
<style>
html,body{margin:0;width:512px;height:512px;background:transparent!important;overflow:hidden}
.ico{position:relative;width:512px;height:512px;border-radius:118px;display:grid;place-items:center;color:#fff;
  background:radial-gradient(circle at 32% 22%,#3A3D48,#121318 62%);box-shadow:inset 0 6px 0 rgba(255,255,255,.14),inset 0 -10px 24px rgba(0,0,0,.5)}
.ico span{font:900 200px/1 var(--font-display);font-stretch:151%;letter-spacing:.01em;text-shadow:0 -4px 0 rgba(0,0,0,.4)}
.ico i{position:absolute;right:92px;bottom:96px;width:56px;height:56px;border-radius:50%;background:radial-gradient(circle at 40% 35%,#D2FFE0,#2FD36B 55%,#13843A);box-shadow:0 0 0 10px #121318}
