<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }} · {{ person.name_short }}</title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#E6E8EE" data-theme-color>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="stylesheet" href="/assets/css/site.css?v={{ v.css }}">
<script src="/assets/js/theme-init.js?v={{ v.init }}"></script>
</head>
<body class="simple-page">
<div class="backdrop" aria-hidden="true"></div>
<main class="simple-wrap">
  <div class="folder">
    <div class="folder-head"><p class="folder-tab"><span>{{ tab }}</span></p><div class="folder-bay"></div></div>
    <div class="folder-body simple-body">
      <h1 class="simple-title">{{ heading }}</h1>
      <p class="simple-copy">{{ copy }}</p>
      <a class="btn btn-ink" href="/">Back to the CV</a>
    </div>
  </div>
</main>
</body>
</html>
